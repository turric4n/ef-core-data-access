<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1705;1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>EntityFrameworkCore.AutoHistory</AssemblyName>
    <PackageId>EntityFrameworkCore.Data.AutoHistory.Unofficial</PackageId>
    <Authors>Lima Technology Services;Fernando Luiz de Lima;Enrique Fuentes (Turric4n)</Authors>
    <Copyright>Copyright © Lima Technology Services;Fernando Luiz de Lima</Copyright>
    <Description>[UNOFFICIAL FORK] Provides AutoHistory utilities for Microsoft.EntityFrameworkCore with .NET 10 support. This is a temporary fork until the official package is updated. Original repository: https://github.com/ffernandolima/ef-core-data-access</Description>
    <PackageProjectUrl>https://github.com/turric4n/ef-core-data-access</PackageProjectUrl>
    <RepositoryUrl>https://github.com/turric4n/ef-core-data-access/tree/ef-core-10</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>EntityFrameworkCore;Entity Framework Core;entity-framework-core;EFCore;EF;Data;O/RM;AutoHistory;Auto History;auto-history;unofficial;net10</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>10.0.1</Version>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.3" />
  </ItemGroup>

</Project>
